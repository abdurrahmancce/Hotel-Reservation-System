-- =====================================================================
-- PART E.4 — UPDATE QUERIES (minimum 5)
-- =====================================================================

-- U1. Give every Receptionist a 5% salary raise
UPDATE Staff
SET Salary = Salary * 1.05
WHERE Position = 'Receptionist';

-- U2. Mark a room under repair (single-row update by PK)
UPDATE Rooms
SET Status = 'Maintenance'
WHERE RoomID = 6;

-- U3. Move a guest's confirmed reservation to a later check-in/out date
UPDATE Reservations
SET CheckInDate = '2026-08-03', CheckOutDate = '2026-08-06'
WHERE ReservationID = 28;

-- U4. Correct a guest's phone number after they reported it was wrong
UPDATE Guests
SET Phone = '01811099999'
WHERE Email = 'sara.ali@example.com';

-- U5. Mark a pending payment as completed
UPDATE Payments
SET PaymentStatus = 'Completed'
WHERE PaymentID = 25;

-- U6. Bulk-update: raise the base rate of every Deluxe room type by 10%
UPDATE RoomTypes
SET BaseRate = BaseRate * 1.10
WHERE TypeName = 'Deluxe';


-- =====================================================================
-- PART E.5 — DELETE QUERIES (minimum 3)
-- =====================================================================

-- D1. Remove a cancelled reservation's leftover service add-ons (if any)
DELETE FROM ReservationServices
WHERE ReservationID IN (SELECT ReservationID FROM Reservations WHERE Status = 'Cancelled');

-- D2. Delete the cancelled reservation itself
--     (fires trg_after_reservation_delete, see Part E.9)
DELETE FROM Reservations
WHERE Status = 'Cancelled';

-- D3. Remove a guest who registered but never made a booking or review
DELETE FROM Guests
WHERE GuestID = (
    SELECT GuestID FROM (
        SELECT g.GuestID
        FROM Guests g
        LEFT JOIN Reservations r ON g.GuestID = r.GuestID
        LEFT JOIN Reviews rv     ON g.GuestID = rv.GuestID
        WHERE r.ReservationID IS NULL AND rv.ReviewID IS NULL
        LIMIT 1
    ) AS t
);

-- D4. Delete a discontinued service (only if unused)
DELETE FROM Services
WHERE ServiceName = 'City Tour'
  AND ServiceID NOT IN (SELECT DISTINCT ServiceID FROM ReservationServices);


-- =====================================================================
-- PART F.1 — SIMPLE QUERIES (minimum 5): SELECT / WHERE / ORDER BY / DISTINCT
-- =====================================================================

-- Q1. All 5-star hotels
SELECT HotelName, City, StarRating
FROM Hotels
WHERE StarRating = 5;

-- Q2. All rooms currently available, cheapest room type first
SELECT r.RoomID, r.RoomNumber, h.HotelName, rt.TypeName, rt.BaseRate
FROM Rooms r
JOIN Hotels h     ON r.HotelID = h.HotelID
JOIN RoomTypes rt ON r.RoomTypeID = rt.RoomTypeID
WHERE r.Status = 'Available'
ORDER BY rt.BaseRate ASC;

-- Q3. Distinct cities that have at least one hotel
SELECT DISTINCT City FROM Hotels;

-- Q4. Guests from Chattogram, alphabetically by last name
SELECT FirstName, LastName, Email
FROM Guests
WHERE City = 'Chattogram'
ORDER BY LastName ASC;

-- Q5. Reservations checking in during January 2026, most recent booking first
SELECT ReservationID, GuestID, CheckInDate, CheckOutDate, Status
FROM Reservations
WHERE CheckInDate BETWEEN '2026-01-01' AND '2026-01-31'
ORDER BY BookingDate DESC;

-- Q6. Distinct payment methods actually used so far
SELECT DISTINCT PaymentMethod FROM Payments;


-- =====================================================================
-- PART F.2 — AGGREGATE FUNCTIONS (minimum 5)
-- =====================================================================

-- A1. COUNT — total number of guests registered
SELECT COUNT(*) AS TotalGuests FROM Guests;

-- A2. SUM — total revenue collected across all completed payments
SELECT SUM(Amount) AS TotalRevenue
FROM Payments
WHERE PaymentStatus = 'Completed';

-- A3. AVG — average nightly rate across all room types
SELECT AVG(BaseRate) AS AvgNightlyRate FROM RoomTypes;

-- A4. MIN / MAX — cheapest and priciest room type
SELECT MIN(BaseRate) AS CheapestRate, MAX(BaseRate) AS MostExpensiveRate
FROM RoomTypes;

-- A5. COUNT + GROUP BY — number of reservations handled by each staff member
SELECT s.FullName, COUNT(r.ReservationID) AS ReservationsHandled
FROM Staff s
LEFT JOIN Reservations r ON s.StaffID = r.StaffID
GROUP BY s.StaffID, s.FullName
ORDER BY ReservationsHandled DESC;

-- A6. AVG rating per hotel
SELECT h.HotelName, ROUND(AVG(rv.Rating),2) AS AvgRating, COUNT(rv.ReviewID) AS NumReviews
FROM Hotels h
JOIN Reviews rv ON h.HotelID = rv.HotelID
GROUP BY h.HotelID, h.HotelName
ORDER BY AvgRating DESC;


-- =====================================================================
-- PART F.3 — JOIN QUERIES (minimum 8)
-- =====================================================================

-- J1. INNER JOIN — reservation list with guest name and room number
SELECT res.ReservationID, g.FirstName, g.LastName, r.RoomNumber, res.CheckInDate, res.CheckOutDate
FROM Reservations res
INNER JOIN Guests g ON res.GuestID = g.GuestID
INNER JOIN Rooms r  ON res.RoomID = r.RoomID;

-- J2. INNER JOIN (3 tables) — reservation with hotel and room type
SELECT res.ReservationID, h.HotelName, rt.TypeName, res.TotalAmount
FROM Reservations res
INNER JOIN Rooms r      ON res.RoomID = r.RoomID
INNER JOIN Hotels h     ON r.HotelID = h.HotelID
INNER JOIN RoomTypes rt ON r.RoomTypeID = rt.RoomTypeID;

-- J3. LEFT JOIN — every guest, with reservation count (0 if none)
SELECT g.GuestID, g.FirstName, g.LastName, COUNT(res.ReservationID) AS NumReservations
FROM Guests g
LEFT JOIN Reservations res ON g.GuestID = res.GuestID
GROUP BY g.GuestID, g.FirstName, g.LastName
ORDER BY NumReservations DESC;

-- J4. LEFT JOIN — every room, with the current active reservation if any
SELECT r.RoomNumber, h.HotelName, res.ReservationID, res.Status
FROM Rooms r
LEFT JOIN Reservations res ON r.RoomID = res.RoomID AND res.Status IN ('Confirmed','CheckedIn')
INNER JOIN Hotels h ON r.HotelID = h.HotelID
ORDER BY h.HotelName, r.RoomNumber;

-- J5. RIGHT JOIN — every service, with reservations that used it (0 if unused)
SELECT sv.ServiceName, rs.ReservationID, rs.Quantity
FROM ReservationServices rs
RIGHT JOIN Services sv ON rs.ServiceID = sv.ServiceID
ORDER BY sv.ServiceName;

-- J6. RIGHT JOIN — every hotel, with staff (right side is Hotels here to show the syntax the other way)
SELECT h.HotelName, s.FullName, s.Position
FROM Staff s
RIGHT JOIN Hotels h ON s.HotelID = h.HotelID
ORDER BY h.HotelName;

-- J7. Multi-table JOIN (4 tables) — full payment ledger with guest & hotel
SELECT p.PaymentID, g.FirstName, g.LastName, h.HotelName, p.Amount, p.PaymentMethod, p.PaymentDate
FROM Payments p
JOIN Reservations res ON p.ReservationID = res.ReservationID
JOIN Guests g          ON res.GuestID = g.GuestID
JOIN Rooms r            ON res.RoomID = r.RoomID
JOIN Hotels h            ON r.HotelID = h.HotelID
ORDER BY p.PaymentDate;

-- J8. Multi-table JOIN (5 tables) — services used, per guest, per hotel
SELECT g.FirstName, g.LastName, h.HotelName, sv.ServiceName, rs.Quantity, rs.ServiceDate
FROM ReservationServices rs
JOIN Services sv       ON rs.ServiceID = sv.ServiceID
JOIN Reservations res  ON rs.ReservationID = res.ReservationID
JOIN Guests g           ON res.GuestID = g.GuestID
JOIN Rooms r            ON res.RoomID = r.RoomID
JOIN Hotels h            ON r.HotelID = h.HotelID
ORDER BY g.LastName;


-- =====================================================================
-- PART F.4 — NESTED QUERIES / SUBQUERIES (minimum 3)
-- =====================================================================

-- N1. Guests who have spent more than the average total per guest
SELECT g.FirstName, g.LastName, SUM(p.Amount) AS TotalSpent
FROM Guests g
JOIN Reservations res ON g.GuestID = res.GuestID
JOIN Payments p        ON res.ReservationID = p.ReservationID
GROUP BY g.GuestID, g.FirstName, g.LastName
HAVING SUM(p.Amount) > (
    SELECT AVG(GuestTotal) FROM (
        SELECT SUM(p2.Amount) AS GuestTotal
        FROM Reservations res2
        JOIN Payments p2 ON res2.ReservationID = p2.ReservationID
        GROUP BY res2.GuestID
    ) AS sub
)
ORDER BY TotalSpent DESC;

-- N2. Rooms that have never been booked
SELECT RoomID, RoomNumber
FROM Rooms
WHERE RoomID NOT IN (SELECT DISTINCT RoomID FROM Reservations);

-- N3. Hotel(s) with the highest average review rating
SELECT HotelName FROM Hotels
WHERE HotelID = (
    SELECT HotelID FROM (
        SELECT HotelID, AVG(Rating) AS AvgRating
        FROM Reviews
        GROUP BY HotelID
        ORDER BY AvgRating DESC
        LIMIT 1
    ) AS best
);

-- N4. Guests who booked a room priced above the overall average base rate
SELECT DISTINCT g.FirstName, g.LastName
FROM Guests g
JOIN Reservations res ON g.GuestID = res.GuestID
WHERE res.RoomID IN (
    SELECT r.RoomID
    FROM Rooms r
    JOIN RoomTypes rt ON r.RoomTypeID = rt.RoomTypeID
    WHERE rt.BaseRate > (SELECT AVG(BaseRate) FROM RoomTypes)
);


-- =====================================================================
-- PART F.5 — VIEWS (minimum 2)
-- =====================================================================

-- V1. Quick front-desk view: current room availability by hotel
CREATE OR REPLACE VIEW vw_RoomAvailability AS
SELECT h.HotelName, r.RoomNumber, rt.TypeName, rt.BaseRate, r.Status
FROM Rooms r
JOIN Hotels h     ON r.HotelID = h.HotelID
JOIN RoomTypes rt ON r.RoomTypeID = rt.RoomTypeID;

-- Usage:  SELECT * FROM vw_RoomAvailability WHERE Status = 'Available';

-- V2. Management view: revenue and reservation summary per hotel
CREATE OR REPLACE VIEW vw_HotelRevenueSummary AS
SELECT h.HotelID, h.HotelName,
       COUNT(DISTINCT res.ReservationID) AS TotalReservations,
       COALESCE(SUM(p.Amount), 0)        AS TotalRevenue
FROM Hotels h
LEFT JOIN Rooms r          ON h.HotelID = r.HotelID
LEFT JOIN Reservations res ON r.RoomID = res.RoomID
LEFT JOIN Payments p       ON res.ReservationID = p.ReservationID AND p.PaymentStatus = 'Completed'
GROUP BY h.HotelID, h.HotelName;

-- Usage:  SELECT * FROM vw_HotelRevenueSummary ORDER BY TotalRevenue DESC;

-- V3 (bonus). Guest loyalty view: total nights & spend per guest
CREATE OR REPLACE VIEW vw_GuestLoyalty AS
SELECT g.GuestID, g.FirstName, g.LastName,
       COUNT(res.ReservationID)                              AS TotalStays,
       COALESCE(SUM(DATEDIFF(res.CheckOutDate, res.CheckInDate)), 0) AS TotalNights,
       COALESCE(SUM(p.Amount), 0)                             AS TotalSpent
FROM Guests g
LEFT JOIN Reservations res ON g.GuestID = res.GuestID AND res.Status <> 'Cancelled'
LEFT JOIN Payments p       ON res.ReservationID = p.ReservationID AND p.PaymentStatus = 'Completed'
GROUP BY g.GuestID, g.FirstName, g.LastName;


-- =====================================================================
-- PART F.6 — FUNCTIONS (minimum 2)
-- =====================================================================

DELIMITER $$

-- Fn1. Number of nights x room's base rate = cost of a stay
CREATE FUNCTION fn_CalculateStayCost(
    p_RoomID INT, p_CheckIn DATE, p_CheckOut DATE
) RETURNS DECIMAL(10,2)
DETERMINISTIC
READS SQL DATA
BEGIN
    DECLARE v_Rate  DECIMAL(10,2);
    DECLARE v_Nights INT;

    SELECT rt.BaseRate INTO v_Rate
    FROM Rooms r
    JOIN RoomTypes rt ON r.RoomTypeID = rt.RoomTypeID
    WHERE r.RoomID = p_RoomID;

    SET v_Nights = DATEDIFF(p_CheckOut, p_CheckIn);

    RETURN v_Rate * v_Nights;
END $$

-- Fn2. Total amount a specific guest has actually paid (completed only)
CREATE FUNCTION fn_GuestTotalSpent(p_GuestID INT)
RETURNS DECIMAL(10,2)
DETERMINISTIC
READS SQL DATA
BEGIN
    DECLARE v_Total DECIMAL(10,2);

    SELECT COALESCE(SUM(p.Amount), 0) INTO v_Total
    FROM Reservations res
    JOIN Payments p ON res.ReservationID = p.ReservationID
    WHERE res.GuestID = p_GuestID AND p.PaymentStatus = 'Completed';

    RETURN v_Total;
END $$

DELIMITER ;

-- Usage:
--   SELECT fn_CalculateStayCost(3, '2026-01-05', '2026-01-08');
--   SELECT fn_GuestTotalSpent(1);


-- =====================================================================
-- PART F.7 — STORED PROCEDURES (minimum 2)
-- =====================================================================

DELIMITER $$

-- P1. Make a new reservation: validates room availability, inserts the
--     booking (TotalAmount auto-filled by the BEFORE INSERT trigger),
--     and flips the room to 'Occupied'.
CREATE PROCEDURE sp_MakeReservation(
    IN p_GuestID   INT,
    IN p_RoomID    INT,
    IN p_StaffID   INT,
    IN p_CheckIn   DATE,
    IN p_CheckOut  DATE,
    IN p_NumGuests TINYINT
)
BEGIN
    DECLARE v_Status VARCHAR(20);

    SELECT Status INTO v_Status FROM Rooms WHERE RoomID = p_RoomID;

    IF v_Status <> 'Available' THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Room is not available for booking.';
    ELSE
        INSERT INTO Reservations (GuestID, RoomID, StaffID, CheckInDate, CheckOutDate, NumGuests)
        VALUES (p_GuestID, p_RoomID, p_StaffID, p_CheckIn, p_CheckOut, p_NumGuests);

        UPDATE Rooms SET Status = 'Occupied' WHERE RoomID = p_RoomID;
    END IF;
END $$

-- P2. Cancel a reservation and free up its room again
CREATE PROCEDURE sp_CancelReservation(IN p_ReservationID INT)
BEGIN
    DECLARE v_RoomID INT;

    SELECT RoomID INTO v_RoomID FROM Reservations WHERE ReservationID = p_ReservationID;

    UPDATE Reservations SET Status = 'Cancelled' WHERE ReservationID = p_ReservationID;
    UPDATE Rooms SET Status = 'Available' WHERE RoomID = v_RoomID;
END $$

-- P3 (bonus). Simple invoice generator for a reservation:
--     returns room cost + extra services + amount already paid
CREATE PROCEDURE sp_GenerateInvoice(IN p_ReservationID INT)
BEGIN
    SELECT
        res.ReservationID,
        g.FirstName, g.LastName,
        res.TotalAmount                                  AS RoomCost,
        COALESCE(SUM(sv.Price * rs.Quantity), 0)          AS ServiceCost,
        res.TotalAmount + COALESCE(SUM(sv.Price * rs.Quantity), 0) AS GrandTotal,
        COALESCE((SELECT SUM(Amount) FROM Payments
                  WHERE ReservationID = p_ReservationID
                  AND PaymentStatus = 'Completed'), 0)     AS AmountPaid
    FROM Reservations res
    JOIN Guests g ON res.GuestID = g.GuestID
    LEFT JOIN ReservationServices rs ON res.ReservationID = rs.ReservationID
    LEFT JOIN Services sv            ON rs.ServiceID = sv.ServiceID
    WHERE res.ReservationID = p_ReservationID
    GROUP BY res.ReservationID, g.FirstName, g.LastName, res.TotalAmount;
END $$

DELIMITER ;

-- Usage:
--   CALL sp_MakeReservation(1, 2, 1, '2026-09-01', '2026-09-04', 2);
--   CALL sp_CancelReservation(28);
--   CALL sp_GenerateInvoice(1);


-- =====================================================================
-- PART F.8 — TRIGGERS (bonus, 2 implemented)
-- =====================================================================

DELIMITER $$

-- T1. BEFORE INSERT — auto-calculate TotalAmount for every new reservation
--     so front-end code never has to compute pricing itself.
CREATE TRIGGER trg_before_reservation_insert
BEFORE INSERT ON Reservations
FOR EACH ROW
BEGIN
    SET NEW.TotalAmount = fn_CalculateStayCost(NEW.RoomID, NEW.CheckInDate, NEW.CheckOutDate);
END $$

-- T2. AFTER DELETE — log every deleted reservation into an audit table
--     instead of silently losing the history (e.g. Part E.5 - D2).
CREATE TRIGGER trg_after_reservation_delete
AFTER DELETE ON Reservations
FOR EACH ROW
BEGIN
    INSERT INTO ReservationAudit (ReservationID, GuestID, ActionType)
    VALUES (OLD.ReservationID, OLD.GuestID, 'DELETED');
END $$

-- T3 (extra bonus). AFTER UPDATE — automatically free the room the moment
--     a reservation's status is changed to 'Cancelled' or 'CheckedOut'.
CREATE TRIGGER trg_after_reservation_status_update
AFTER UPDATE ON Reservations
FOR EACH ROW
BEGIN
    IF NEW.Status IN ('Cancelled','CheckedOut') AND OLD.Status <> NEW.Status THEN
        UPDATE Rooms SET Status = 'Available' WHERE RoomID = NEW.RoomID;
    END IF;
END $$

DELIMITER ;


-- =====================================================================
-- PART G — REPORTS (10 useful business reports)
-- =====================================================================

-- R1. Total revenue collected, hotel-wise (best-earning hotel first)
SELECT * FROM vw_HotelRevenueSummary ORDER BY TotalRevenue DESC;

-- R2. Top 5 highest-spending guests
SELECT GuestID, FirstName, LastName, TotalSpent
FROM vw_GuestLoyalty
ORDER BY TotalSpent DESC
LIMIT 5;

-- R3. Most popular room type by number of bookings
SELECT rt.TypeName, COUNT(res.ReservationID) AS TimesBooked
FROM RoomTypes rt
JOIN Rooms r          ON rt.RoomTypeID = r.RoomTypeID
JOIN Reservations res ON r.RoomID = res.RoomID
GROUP BY rt.RoomTypeID, rt.TypeName
ORDER BY TimesBooked DESC;

-- R4. Currently available rooms, hotel-wise
SELECT HotelName, COUNT(*) AS AvailableRooms
FROM vw_RoomAvailability
WHERE Status = 'Available'
GROUP BY HotelName
ORDER BY AvailableRooms DESC;

-- R5. Monthly revenue report (year-month breakdown)
SELECT DATE_FORMAT(PaymentDate, '%Y-%m') AS Month, SUM(Amount) AS Revenue
FROM Payments
WHERE PaymentStatus = 'Completed'
GROUP BY DATE_FORMAT(PaymentDate, '%Y-%m')
ORDER BY Month;

-- R6. Staff salary report, hotel-wise (highest paid first)
SELECT h.HotelName, s.FullName, s.Position, s.Salary
FROM Staff s
JOIN Hotels h ON s.HotelID = h.HotelID
ORDER BY h.HotelName, s.Salary DESC;

-- R7. Reservation status summary (how many are confirmed / cancelled / etc.)
SELECT Status, COUNT(*) AS Total
FROM Reservations
GROUP BY Status;

-- R8. Hotel-wise average guest review rating (best rated first)
SELECT HotelName, AvgRating, NumReviews
FROM (
    SELECT h.HotelName, ROUND(AVG(rv.Rating),2) AS AvgRating, COUNT(rv.ReviewID) AS NumReviews
    FROM Hotels h
    JOIN Reviews rv ON h.HotelID = rv.HotelID
    GROUP BY h.HotelID, h.HotelName
) AS t
ORDER BY AvgRating DESC;

-- R9. Best-selling extra service, by total quantity ordered
SELECT sv.ServiceName, SUM(rs.Quantity) AS TotalSold, SUM(rs.Quantity * sv.Price) AS Revenue
FROM ReservationServices rs
JOIN Services sv ON rs.ServiceID = sv.ServiceID
GROUP BY sv.ServiceID, sv.ServiceName
ORDER BY TotalSold DESC;

-- R10. Guests with more than one reservation (repeat customers)
SELECT GuestID, FirstName, LastName, TotalStays
FROM vw_GuestLoyalty
WHERE TotalStays > 1
ORDER BY TotalStays DESC;

-- R11 (bonus). Occupancy rate per hotel: occupied rooms vs total rooms
SELECT h.HotelName,
       COUNT(r.RoomID)                                   AS TotalRooms,
       SUM(CASE WHEN r.Status = 'Occupied' THEN 1 ELSE 0 END) AS OccupiedRooms,
       ROUND(100 * SUM(CASE WHEN r.Status = 'Occupied' THEN 1 ELSE 0 END) / COUNT(r.RoomID), 1) AS OccupancyPercent
FROM Hotels h
JOIN Rooms r ON h.HotelID = r.HotelID
GROUP BY h.HotelID, h.HotelName
ORDER BY OccupancyPercent DESC;

