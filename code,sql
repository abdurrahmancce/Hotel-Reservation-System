-- =====================================================================
-- PART E.1 — DATABASE CREATION
-- =====================================================================
DROP DATABASE IF EXISTS HotelReservationSystem;
CREATE DATABASE HotelReservationSystem;
USE HotelReservationSystem;


-- =====================================================================
-- PART E.2 — TABLE CREATION (DDL)
-- =====================================================================

-- ---------------------------------------------------------------
-- 1. HOTELS  (one row per physical hotel property)
-- ---------------------------------------------------------------
CREATE TABLE Hotels (
    HotelID       INT AUTO_INCREMENT PRIMARY KEY,
    HotelName     VARCHAR(100) NOT NULL,
    City          VARCHAR(50)  NOT NULL,
    Address       VARCHAR(150) NOT NULL,
    Phone         VARCHAR(20)  NOT NULL UNIQUE,
    StarRating    TINYINT      NOT NULL DEFAULT 3 CHECK (StarRating BETWEEN 1 AND 5),
    OpeningDate   DATE         NOT NULL
);

-- ---------------------------------------------------------------
-- 2. ROOM TYPES (Single / Double / Deluxe / Suite / Executive ...)
-- ---------------------------------------------------------------
CREATE TABLE RoomTypes (
    RoomTypeID    INT AUTO_INCREMENT PRIMARY KEY,
    TypeName      VARCHAR(50)   NOT NULL UNIQUE,
    BaseRate      DECIMAL(10,2) NOT NULL CHECK (BaseRate > 0),
    MaxOccupancy  TINYINT       NOT NULL DEFAULT 2 CHECK (MaxOccupancy > 0),
    Description   VARCHAR(255)
);

-- ---------------------------------------------------------------
-- 3. ROOMS (physical rooms, each belongs to one hotel & one type)
-- ---------------------------------------------------------------
CREATE TABLE Rooms (
    RoomID        INT AUTO_INCREMENT PRIMARY KEY,
    HotelID       INT NOT NULL,
    RoomTypeID    INT NOT NULL,
    RoomNumber    VARCHAR(10) NOT NULL,
    Floor         TINYINT NOT NULL DEFAULT 1,
    Status        ENUM('Available','Occupied','Maintenance') NOT NULL DEFAULT 'Available',
    CONSTRAINT fk_rooms_hotel     FOREIGN KEY (HotelID)     REFERENCES Hotels(HotelID)       ON DELETE CASCADE,
    CONSTRAINT fk_rooms_roomtype  FOREIGN KEY (RoomTypeID)  REFERENCES RoomTypes(RoomTypeID)  ON DELETE RESTRICT,
    CONSTRAINT uq_room_per_hotel  UNIQUE (HotelID, RoomNumber)
);

-- ---------------------------------------------------------------
-- 4. GUESTS (customers who book rooms)
-- ---------------------------------------------------------------
CREATE TABLE Guests (
    GuestID         INT AUTO_INCREMENT PRIMARY KEY,
    FirstName       VARCHAR(50)  NOT NULL,
    LastName        VARCHAR(50)  NOT NULL,
    Email           VARCHAR(100) NOT NULL UNIQUE,
    Phone           VARCHAR(20)  NOT NULL,
    Address         VARCHAR(150),
    City            VARCHAR(50),
    NIDPassport     VARCHAR(30)  UNIQUE,
    DOB             DATE,
    RegisteredDate  DATE NOT NULL DEFAULT (CURRENT_DATE)
);

-- ---------------------------------------------------------------
-- 5. STAFF (hotel employees; the one who processes a booking)
-- ---------------------------------------------------------------
CREATE TABLE Staff (
    StaffID     INT AUTO_INCREMENT PRIMARY KEY,
    HotelID     INT NOT NULL,
    FullName    VARCHAR(100) NOT NULL,
    Position    VARCHAR(50)  NOT NULL,
    Salary      DECIMAL(10,2) NOT NULL CHECK (Salary >= 0),
    Phone       VARCHAR(20),
    HireDate    DATE NOT NULL,
    CONSTRAINT fk_staff_hotel FOREIGN KEY (HotelID) REFERENCES Hotels(HotelID) ON DELETE CASCADE
);

-- ---------------------------------------------------------------
-- 6. RESERVATIONS (the central transaction table)
-- ---------------------------------------------------------------
CREATE TABLE Reservations (
    ReservationID   INT AUTO_INCREMENT PRIMARY KEY,
    GuestID         INT NOT NULL,
    RoomID          INT NOT NULL,
    StaffID         INT,
    CheckInDate     DATE NOT NULL,
    CheckOutDate    DATE NOT NULL,
    BookingDate     DATE NOT NULL DEFAULT (CURRENT_DATE),
    NumGuests       TINYINT NOT NULL DEFAULT 1 CHECK (NumGuests > 0),
    Status          ENUM('Confirmed','CheckedIn','CheckedOut','Cancelled') NOT NULL DEFAULT 'Confirmed',
    TotalAmount     DECIMAL(10,2) NOT NULL DEFAULT 0,
    CONSTRAINT fk_res_guest  FOREIGN KEY (GuestID) REFERENCES Guests(GuestID) ON DELETE CASCADE,
    CONSTRAINT fk_res_room   FOREIGN KEY (RoomID)  REFERENCES Rooms(RoomID)   ON DELETE RESTRICT,
    CONSTRAINT fk_res_staff  FOREIGN KEY (StaffID)  REFERENCES Staff(StaffID) ON DELETE SET NULL,
    CONSTRAINT chk_res_dates CHECK (CheckOutDate > CheckInDate)
);

-- ---------------------------------------------------------------
-- 7. PAYMENTS (one reservation can have several part-payments)
-- ---------------------------------------------------------------
CREATE TABLE Payments (
    PaymentID       INT AUTO_INCREMENT PRIMARY KEY,
    ReservationID   INT NOT NULL,
    Amount          DECIMAL(10,2) NOT NULL CHECK (Amount > 0),
    PaymentDate     DATE NOT NULL DEFAULT (CURRENT_DATE),
    PaymentMethod   ENUM('Cash','Card','MobileBanking','BankTransfer') NOT NULL,
    PaymentStatus   ENUM('Pending','Completed','Refunded') NOT NULL DEFAULT 'Completed',
    CONSTRAINT fk_pay_res FOREIGN KEY (ReservationID) REFERENCES Reservations(ReservationID) ON DELETE CASCADE
);

-- ---------------------------------------------------------------
-- 8. SERVICES (extra hotel services: spa, laundry, breakfast, ...)
-- ---------------------------------------------------------------
CREATE TABLE Services (
    ServiceID     INT AUTO_INCREMENT PRIMARY KEY,
    ServiceName   VARCHAR(50) NOT NULL UNIQUE,
    Price         DECIMAL(8,2) NOT NULL CHECK (Price >= 0)
);

-- ---------------------------------------------------------------
-- 9. RESERVATION_SERVICES (junction: M:N between Reservations & Services)
-- ---------------------------------------------------------------
CREATE TABLE ReservationServices (
    ResServiceID    INT AUTO_INCREMENT PRIMARY KEY,
    ReservationID   INT NOT NULL,
    ServiceID       INT NOT NULL,
    Quantity        INT NOT NULL DEFAULT 1 CHECK (Quantity > 0),
    ServiceDate     DATE NOT NULL DEFAULT (CURRENT_DATE),
    CONSTRAINT fk_rs_res FOREIGN KEY (ReservationID) REFERENCES Reservations(ReservationID) ON DELETE CASCADE,
    CONSTRAINT fk_rs_svc FOREIGN KEY (ServiceID)     REFERENCES Services(ServiceID)         ON DELETE RESTRICT
);

-- ---------------------------------------------------------------
-- 10. REVIEWS (a guest reviews a hotel after a stay)
-- ---------------------------------------------------------------
CREATE TABLE Reviews (
    ReviewID    INT AUTO_INCREMENT PRIMARY KEY,
    GuestID     INT NOT NULL,
    HotelID     INT NOT NULL,
    Rating      TINYINT NOT NULL CHECK (Rating BETWEEN 1 AND 5),
    Comment     VARCHAR(255),
    ReviewDate  DATE NOT NULL DEFAULT (CURRENT_DATE),
    CONSTRAINT fk_rev_guest FOREIGN KEY (GuestID) REFERENCES Guests(GuestID) ON DELETE CASCADE,
    CONSTRAINT fk_rev_hotel FOREIGN KEY (HotelID) REFERENCES Hotels(HotelID) ON DELETE CASCADE
);

-- ---------------------------------------------------------------
-- 11. RESERVATION_AUDIT (support table used by the DELETE trigger)
-- ---------------------------------------------------------------
CREATE TABLE ReservationAudit (
    AuditID         INT AUTO_INCREMENT PRIMARY KEY,
    ReservationID   INT NOT NULL,
    GuestID         INT NOT NULL,
    ActionType      VARCHAR(20) NOT NULL,
    ActionDate      DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);


